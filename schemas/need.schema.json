{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s0fractal/decision-archaeology/blob/main/schemas/need.schema.json",
  "title": "Decision Archaeology evidence-bound need",
  "description": "A case-derived request routed to the repository that owns the affected contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "template",
    "id",
    "status",
    "source",
    "target",
    "need",
    "reproducer",
    "boundaries",
    "provenance",
    "paths"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "decision-archaeology.need@v0" },
    "template": {
      "type": "string",
      "pattern": "^decision-archaeology\\.need-template@v0\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^DA-[A-Z0-9]+-[0-9]{4}$"
    },
    "status": {
      "enum": ["draft", "filed", "triaged", "fulfilled", "declined", "blocked", "superseded"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "case_id", "artifacts"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "surface"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "surface": { "type": "string", "minLength": 1 }
      }
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocked_operation",
        "current_behavior",
        "required_capability",
        "local_workaround",
        "why_workaround_is_insufficient",
        "candidate_placement"
      ],
      "properties": {
        "blocked_operation": { "type": "string", "minLength": 1 },
        "current_behavior": { "type": "string", "minLength": 1 },
        "required_capability": { "type": "string", "minLength": 1 },
        "local_workaround": { "type": "string", "minLength": 1 },
        "why_workaround_is_insufficient": { "type": "string", "minLength": 1 },
        "candidate_placement": {
          "enum": ["unknown", "existing-contract", "application-adapter", "profile", "protocol"]
        }
      }
    },
    "reproducer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "expected", "counterexample"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "counterexample": { "type": "string", "minLength": 1 }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_minimization", "non_claims"],
      "properties": {
        "data_minimization": { "type": "string", "minLength": 1 },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "generated_at", "authority"],
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "authority": { "const": "case-derived-demand-only" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "fixtures", "disposition"],
      "properties": {
        "narrative": { "const": "request.md" },
        "fixtures": { "const": "fixtures/" },
        "disposition": { "const": "disposition.json" }
      }
    }
  }
}
