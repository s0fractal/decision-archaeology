{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s0fractal/decision-archaeology/blob/main/schemas/need-outcome.schema.json",
  "title": "Decision Archaeology need outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "status",
    "classification",
    "target",
    "resolution",
    "replay",
    "rebuild",
    "recorded_at",
    "producer",
    "authority",
    "non_claims"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "decision-archaeology.need-outcome@v1" },
    "supersedes": {
      "type": "string",
      "minLength": 1,
      "description": "Repository path of the earlier receipt this one replaces. The earlier receipt is kept byte for byte; a correction is never an edit."
    },
    "request_id": { "type": "string", "pattern": "^DA-[A-Z0-9]+-[0-9]{4}$" },
    "status": { "enum": ["fulfilled", "declined", "blocked", "superseded"] },
    "classification": {
      "enum": [
        "already-supported",
        "application-adapter",
        "profile-change",
        "protocol-candidate",
        "wrong-owner",
        "declined",
        "blocked"
      ]
    },
    "target": { "$ref": "#/$defs/target" },
    "resolution": { "$ref": "#/$defs/resolution" },
    "replay": { "$ref": "#/$defs/replay" },
    "rebuild": { "$ref": "#/$defs/rebuild" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "authority": { "const": "outcome-linkage-only" },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "disposition_revision", "disposition"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "disposition_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "disposition": { "$ref": "#/$defs/artifact" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "profile", "artifacts"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "profile": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "rebuild": {
      "type": "object",
      "description": "A rebuild of the resolution derived from its published description alone, by something that did not read the reference implementation.",
      "additionalProperties": false,
      "required": ["revision", "path", "sha256", "command", "derived_from", "excludes"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "command": { "type": "string", "minLength": 1 },
        "derived_from": { "type": "string", "minLength": 1 },
        "excludes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "command", "expected", "receipt"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "receipt": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
